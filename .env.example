# Database
DATABASE_URL="postgresql://iist_user:iist_pass@localhost:5432/iist_career_db"

# Auth
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Email (SMTP)
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@iist.ac.in"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="IIST Placement Cell <noreply@iist.ac.in>"

# Storage
STORAGE_DRIVER="local"
# For S3:
# STORAGE_DRIVER="s3"
# AWS_ACCESS_KEY_ID="..."
# AWS_SECRET_ACCESS_KEY="..."
# AWS_REGION="ap-south-1"
# AWS_S3_BUCKET="iist-career-portal"
# AWS_ENDPOINT_URL="http://localhost:9000"  # for minio

# AI
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY="sk-ant-..."

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="IIST Placement Portal"
