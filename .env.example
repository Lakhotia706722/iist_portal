# ─── Database ──────────────────────────────────────────────────────────────
# Phase 16 — P1.1: in production, DATABASE_URL MUST be the *pooled*
# connection string your Postgres provider gives you (Neon: the "-pooler"
# host; Supabase: the pooler port, typically 6543, with pgbouncer=true) —
# without it, real concurrent load exhausts Postgres's connection limit
# suddenly under 1000+ users, not gradually. DIRECT_URL is the *unpooled*
# connection, used only by `prisma migrate` (schema migrations need a
# direct session, not a transaction-mode pooler). Set an explicit
# connection_limit on the pooled URL sized to (provider's max connections
# / expected peak concurrent function instances) — see LAUNCH_CHECKLIST.md
# for the actual number chosen and why.
#
# Locally, both simply point at the same unpooled local Postgres — there is
# no pooler to speak of until a real Neon/Supabase project exists.
DATABASE_URL="postgresql://iist_user:iist_pass@localhost:5432/iist_career_db"
DIRECT_URL="postgresql://iist_user:iist_pass@localhost:5432/iist_career_db"
# Production example (Neon):
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/dbname?sslmode=require&connection_limit=5"
# DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/dbname?sslmode=require"

# ─── Auth (Auth.js v5) ─────────────────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# AUTH_URL / NEXTAUTH_URL: leave both unset. lib/auth/auth.config.ts sets
# trustHost:true, so Auth.js infers the correct origin from each request's
# own Host header — which is what you want any time the app might be
# reached on more than one host/port (this repo's own E2E suite runs the
# dev server on :4242 instead of the default :3000; a hardcoded value here
# silently wins over that inference for every redirect, which only looks
# fine if you happen to always use the one port it names). Set one only to
# force a specific external origin, e.g. behind a reverse proxy that
# doesn't forward Host correctly.
# AUTH_URL="http://localhost:3000"
# NEXTAUTH_URL="http://localhost:3000"

# ─── Email (SMTP) ──────────────────────────────────────────────────────────
# In development, leaving SMTP_USER unset makes sendEmail() log to the
# console instead of sending — no SMTP server needed to develop locally.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@iist.ac.in"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="IIST Placement Cell <noreply@iist.ac.in>"

# ─── Storage ────────────────────────────────────────────────────────────────
# "local" writes to disk under LOCAL_STORAGE_PATH and serves files back
# through /api/files/[key] (auth-gated). Only viable for local dev — Vercel's
# filesystem is ephemeral, so production MUST use "s3".
#
# Locked provider (Phase 6): Cloudflare R2 — no egress fees, S3-compatible API.
# Create a bucket + API token at https://dash.cloudflare.com/?to=/:account/r2,
# then fill in the values below (real AWS S3 also works unmodified: set
# AWS_REGION to a real region and drop AWS_ENDPOINT_URL).
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./uploads"

# Required when STORAGE_DRIVER="s3":
# AWS_ACCESS_KEY_ID="<R2 API token access key id>"
# AWS_SECRET_ACCESS_KEY="<R2 API token secret access key>"
# AWS_REGION="auto"                                    # R2 uses the literal string "auto"
# AWS_S3_BUCKET="iist-career-portal"
# AWS_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"

# ─── AI (Phase 5 — AI Resume Builder, JD analysis, career/job recommendations,
# interview practice feedback) ───────────────────────────────────────────────
# Leave AI_PROVIDER unset (or set to anything other than "anthropic") to run
# without AI configured — those features return a clear "not configured"
# error instead of failing unpredictably; nothing else in the app depends on
# this being set.
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Distributed rate limiting & light caching (Phase 16 — P2) ────────────
# Without both set, lib/rate-limit.ts falls back to an in-memory limiter —
# correct for local dev, but NOT distributed across serverless instances.
# Get these from https://console.upstash.com/redis (free tier is enough).
# UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="..."

# ─── Background job queue (Phase 16 — P4) ──────────────────────────────────
# Without this, notification emails (single or bulk) send inline in the
# request instead of being queued — correct for local dev, but doesn't
# decouple anything. Get it from https://console.upstash.com/qstash.
# QSTASH_TOKEN="..."
# QSTASH_CURRENT_SIGNING_KEY="..."   # for verifySignatureAppRouter on /api/jobs/*
# QSTASH_NEXT_SIGNING_KEY="..."

# ─── Error tracking (Phase 16 — P7) ─────────────────────────────────────────
# Without these, Sentry.init() runs with enabled:false — a documented,
# safe no-op (see sentry.server.config.ts) — so local dev needs nothing
# here. NEXT_PUBLIC_SENTRY_DSN is exposed to the browser bundle (Sentry
# DSNs are not secret — safe to expose) for client-side capture;
# SENTRY_DSN is used server/edge-side. Typically the same DSN value in
# both. SENTRY_AUTH_TOKEN (org-level, keep this one actually secret) is
# only needed to upload source maps at build time — omit it and builds
# just skip that step.
# NEXT_PUBLIC_SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# SENTRY_DSN="https://xxx@xxx.ingest.sentry.io/xxx"
# SENTRY_ORG="your-org"
# SENTRY_PROJECT="iist-career-portal"
# SENTRY_AUTH_TOKEN="..."

# ─── App ────────────────────────────────────────────────────────────────────
# This project's own dev-server convention is :4242, not Next's default
# :3000 (see playwright.config.ts) — keep this in sync with whatever port
# you actually run on. A mismatch here silently breaks locally-signed
# storage URLs (STORAGE_DRIVER=local) and presigned local-upload URLs, since
# both are built from this value — see lib/storage/local-adapter.ts.
NEXT_PUBLIC_APP_URL="http://localhost:4242"
NEXT_PUBLIC_APP_NAME="IIST Placement Portal"
