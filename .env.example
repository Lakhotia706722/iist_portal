# ─── Database ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://iist_user:iist_pass@localhost:5432/iist_career_db"

# ─── Auth (Auth.js v5) ─────────────────────────────────────────────────────
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# AUTH_URL / NEXTAUTH_URL: leave both unset. lib/auth/auth.config.ts sets
# trustHost:true, so Auth.js infers the correct origin from each request's
# own Host header — which is what you want any time the app might be
# reached on more than one host/port (this repo's own E2E suite runs the
# dev server on :4242 instead of the default :3000; a hardcoded value here
# silently wins over that inference for every redirect, which only looks
# fine if you happen to always use the one port it names). Set one only to
# force a specific external origin, e.g. behind a reverse proxy that
# doesn't forward Host correctly.
# AUTH_URL="http://localhost:3000"
# NEXTAUTH_URL="http://localhost:3000"

# ─── Email (SMTP) ──────────────────────────────────────────────────────────
# In development, leaving SMTP_USER unset makes sendEmail() log to the
# console instead of sending — no SMTP server needed to develop locally.
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="noreply@iist.ac.in"
SMTP_PASS="your-smtp-password"
EMAIL_FROM="IIST Placement Cell <noreply@iist.ac.in>"

# ─── Storage ────────────────────────────────────────────────────────────────
# "local" writes to disk under LOCAL_STORAGE_PATH and serves files back
# through /api/files/[key] (auth-gated). Only viable for local dev — Vercel's
# filesystem is ephemeral, so production MUST use "s3".
#
# Locked provider (Phase 6): Cloudflare R2 — no egress fees, S3-compatible API.
# Create a bucket + API token at https://dash.cloudflare.com/?to=/:account/r2,
# then fill in the values below (real AWS S3 also works unmodified: set
# AWS_REGION to a real region and drop AWS_ENDPOINT_URL).
STORAGE_DRIVER="local"
LOCAL_STORAGE_PATH="./uploads"

# Required when STORAGE_DRIVER="s3":
# AWS_ACCESS_KEY_ID="<R2 API token access key id>"
# AWS_SECRET_ACCESS_KEY="<R2 API token secret access key>"
# AWS_REGION="auto"                                    # R2 uses the literal string "auto"
# AWS_S3_BUCKET="iist-career-portal"
# AWS_ENDPOINT_URL="https://<account_id>.r2.cloudflarestorage.com"

# ─── AI (Phase 5 — AI Resume Builder, JD analysis, career/job recommendations,
# interview practice feedback) ───────────────────────────────────────────────
# Leave AI_PROVIDER unset (or set to anything other than "anthropic") to run
# without AI configured — those features return a clear "not configured"
# error instead of failing unpredictably; nothing else in the app depends on
# this being set.
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY="sk-ant-..."

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="IIST Placement Portal"
